# Which LLM provider to use for operator-note interpretation: "anthropic" or "gemini".
# If omitted, defaults to "gemini" when GEMINI_API_KEY is set, otherwise "anthropic".
LLM_PROVIDER=gemini

# API key for the selected provider. You can also use ANTHROPIC_API_KEY or
# GEMINI_API_KEY directly instead of LLM_API_KEY.
LLM_API_KEY=your_api_key_here

# Model identifier passed to the provider.
# Anthropic example: claude-haiku-4-5-20251001
# Gemini example: gemini-flash-lite-latest (higher free-tier request quota than
# newer preview flash models, which are capped at 20 requests/day for new API keys)
LLM_MODEL=gemini-flash-lite-latest

# Leave blank to use the provider's default base URL (Anthropic only).
LLM_BASE_URL=

# Port the service listens on.
PORT=8000
